<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification bar icon: pregnant woman in lotus meditation pose.
  Must be monochrome white on transparent background.
  Android tints this automatically with the notification accent color.
  Designed for 24dp render size — keep shapes bold and readable.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Head -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,1.5
            C13.4,1.5 14.5,2.6 14.5,4
            C14.5,5.4 13.4,6.5 12,6.5
            C10.6,6.5 9.5,5.4 9.5,4
            C9.5,2.6 10.6,1.5 12,1.5 Z" />

    <!-- Neck -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M11,6.2 L11,7.3 L13,7.3 L13,6.2 Z" />

    <!--
      Torso with pregnant belly.
      At y≈9.7 (chest)  the path spans x=9→15   (6 units wide).
      At y≈13   (belly) the path spans x=7.5→16.5 (9 units wide — 50% wider).
      At y=16   (hips)  the path spans x=9→15   (6 units wide).
      The clear belly-area bulge makes the pregnancy visible at notification size.
    -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M11,7.3
            C9.5,7.8 9,8.8 9,9.8
            C9,10.8 7.5,11.8 7.5,13.2
            C7.5,14.2 8.5,15.2 9,16
            L15,16
            C15.5,15.2 16.5,14.2 16.5,13.2
            C16.5,11.8 15,10.8 15,9.8
            C15,8.8 14.5,7.8 13,7.3 Z" />

    <!--
      Lotus position legs.
      Fans outward from the hips (x=9→15 at y=16) down to a wide,
      rounded crescent base (x=4→20 at y=19, x=5→19 at y=22.5).
      This classic wide-based triangular shape reads clearly as lotus pose.
    -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M9,16
            C7,16.5 5,17.5 4,19
            C3,20.5 3.5,22 5,22.5
            L19,22.5
            C20.5,22 21,20.5 20,19
            C19,17.5 17,16.5 15,16 Z" />

</vector>
